<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="500.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tuempresa.evaluacion2.ConsultaClientesController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
            <children>
                <!-- Título de la ventana -->
                <Label text="Consulta de Clientes">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>

                <!-- Tabla de Clientes -->
                <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNombre" prefWidth="155.0" text="Nombre completo" />
                        <TableColumn fx:id="colTipoCliente" prefWidth="132.0" text="Tipo de cliente" />
                        <TableColumn fx:id="colCiudad" prefWidth="120.0" text="Ciudad" />
                        <TableColumn fx:id="colFechaNac" prefWidth="130.0" text="Fecha de nacimiento" />
                        <TableColumn fx:id="colTipoSolicitud" prefWidth="140.0" text="Tipo de solicitud" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <!-- Botones inferiores -->
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#onVerDetalleAction" text="Ver / Editar Detalle" />
                        <Button mnemonicParsing="false" onAction="#onCerrarAction" text="Cerrar" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>